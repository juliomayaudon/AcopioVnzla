# ── Base de datos (PostgreSQL) ──────────────────────────────────────
# En Railway: usa la variable de referencia ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://usuario:password@host:5432/acopio_vzla"

# ── NextAuth ────────────────────────────────────────────────────────
# Genera un secreto fuerte con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-fuerte"
# URL pública de la app (en producción, la URL HTTPS de Railway)
NEXTAUTH_URL="https://tu-app.up.railway.app"

# ── Cloudinary (imágenes / banners) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu_cloud_name"
